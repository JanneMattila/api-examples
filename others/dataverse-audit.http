@tenant = {{$dotenv tenant}}
@client_id = {{$dotenv client_id}}
@client_secret = {{$dotenv client_secret}}

##
# Dataverse organization
@organization_name = {{$dotenv organization_name}}
##

### Get token
# @name tokenResponse
POST https://login.microsoftonline.com/{{tenant}}/oauth2/v2.0/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}
&client_secret={{client_secret}}
&scope=https://{{organization_name}}.crm.dynamics.com/.default
&grant_type=client_credentials

### Fetch audit log
# @name auditLogResponse
GET https://{{organization_name}}.crm.dynamics.com/api/data/v9.2/audits HTTP/1.1
Content-Type: application/json
Accept: application/json  
OData-MaxVersion: 4.0  
OData-Version: 4.0
If-None-Match: null
Prefer: odata.include-annotations="*" 
Authorization: Bearer {{tokenResponse.response.body.access_token}}

### Fetch audit log after created on
# @name auditLogResponse
GET https://{{organization_name}}.crm.dynamics.com/api/data/v9.2/audits
    ?$filter=createdon gt 2026-09-03T15:29:11.512Z
    &$orderby=createdon desc
Content-Type: application/json
Accept: application/json  
OData-MaxVersion: 4.0  
OData-Version: 4.0
If-None-Match: null
Prefer: odata.include-annotations="*" 
Authorization: Bearer {{tokenResponse.response.body.access_token}}

### Update account city to "City-" and running number
# @name updateAccountResponse
PATCH https://{{organization_name}}.crm.dynamics.com/api/data/v9.0/accounts(ee17f445-a6a7-f111-b8dd-000d3a199a69) HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenResponse.response.body.access_token}}

{
    "address1_city":"City-{{$randomInt 1 1000}}"
}

### Get account
GET https://{{organization_name}}.crm.dynamics.com/api/data/v9.0/accounts(ee17f445-a6a7-f111-b8dd-000d3a199a69) HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokenResponse.response.body.access_token}}
